<?xml version="1.0" encoding="utf-8"?>
<!--
  ZT Camera widget: Private shot (the camera saving straight to the Private
  vault), the camera, the code scanner and the document scanner. It shows no
  photos and nothing about them, so it needs no privacy switch.
  CameraWidgetProvider shows as many buttons as fit: 1x1 is Private shot alone.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    style="@style/ZtWidget.Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="@dimen/zt_widget_header_icon"
            android:layout_height="@dimen/zt_widget_header_icon"
            android:src="@mipmap/ic_launcher"
            android:importantForAccessibility="no"/>
        <TextView
            style="@style/ZtWidget.AppName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/widget_camera_app"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout
            android:id="@+id/private_shot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="@string/widget_private_shot">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/zt_widget_accent_circle"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_zt_widget_private"
                android:tint="@color/zt_widget_on_accent"
                android:importantForAccessibility="no"/>
            <TextView
                android:id="@+id/private_shot_label"
                style="@style/ZtWidget.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/widget_private_shot"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/camera"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="@string/widget_open_camera">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/zt_widget_tile_circle"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_camera"
                android:tint="@color/zt_widget_on_surface"
                android:importantForAccessibility="no"/>
            <TextView
                android:id="@+id/camera_label"
                style="@style/ZtWidget.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/widget_open_camera"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/scan_code"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="@string/widget_scan_code">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/zt_widget_tile_circle"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_zt_widget_qr"
                android:tint="@color/zt_widget_on_surface"
                android:importantForAccessibility="no"/>
            <TextView
                android:id="@+id/scan_code_label"
                style="@style/ZtWidget.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/widget_scan_code"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/scan_document"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:contentDescription="@string/widget_scan_document">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/zt_widget_tile_circle"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_document"
                android:tint="@color/zt_widget_on_surface"
                android:importantForAccessibility="no"/>
            <TextView
                android:id="@+id/scan_document_label"
                style="@style/ZtWidget.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/widget_scan_document"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
