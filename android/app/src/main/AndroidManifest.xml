<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Sign-in with the shared Zero-Trust account (optional; the camera
         itself never uses the network). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Only to tell Wi-Fi from mobile data, for the vault backup's
         "Wi-Fi only" rule. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Optional, asked for only when "Add location" is turned on in the
         Private vault. The place is kept in the vault item's sealed
         details, never in a picture and never for gallery photos. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <!-- The camera screens (launcher, camera intents, lock-screen camera,
         in-app gallery) are declared by the capture module's manifest and
         merged in. Its App class is the application: it applies the picked
         language and keeps track of the open viewfinder.
         allowBackup off: the phone's backup can't carry the Keystore keys the
         account data is locked with, and a restore without them breaks
         sign-in. -->
    <application
        android:name="dev.sagron.zerotrustcamera.capture.App"
        android:label="ZT Camera"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:resizeableActivity="false"
        android:theme="@style/Theme.App"
        android:enableOnBackInvokedCallback="true"
        android:memtagMode="async"
        tools:ignore="UnusedAttribute">
        <!-- Account, language, appearance and about (Flutter). No launcher
             entry: it opens from the camera's settings. Exported only for the
             password-reset link below. -->
        <activity
            android:name=".ZtAppActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Links are handled by the app's own code (EmailLinks), not
                 Flutter's router. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false"/>
            <!-- Password-reset emails: https://zerotrust.bz/auth/camera/#token_hash=… (see EmailLinks). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="zerotrust.bz" android:pathPrefix="/auth/camera/"/>
            </intent-filter>
        </activity>

        <!-- Cleaned copies of Private vault items being shared (VaultChannel). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.vaultshare"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/vault_share_paths"/>
        </provider>

        <!-- Home screen widget: Private shot, Camera, Scan code, Document.
             Exported so the launcher can ask it to draw; its buttons open
             this app's own screens. -->
        <receiver
            android:name=".widgets.CameraWidgetProvider"
            android:label="@string/widget_camera_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_camera_info" />
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
